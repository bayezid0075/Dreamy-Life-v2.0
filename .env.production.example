# =============================================================================
# Production env example (project root)
# Copy to .env.production on the VPS.
#
# Used by:
# - Django when DJANGO_ENV=production
# - docker compose via: docker compose --env-file .env.production ...
# =============================================================================

# === Database (Postgres) ===
POSTGRES_DB=dreamy_life
POSTGRES_USER=postgres
POSTGRES_PASSWORD=set-a-strong-password

DB_ENGINE=django.db.backends.postgresql
DB_NAME=dreamy_life
DB_USER=postgres
DB_PASSWORD=set-a-strong-password
DB_HOST=postgres
DB_PORT=5432

# === Django ===
SECRET_KEY=change-this-to-a-long-random-string
DEBUG=True
DJANGO_ENV=production

# === URLs (set to VPS IP or domain; prefer HTTPS with a reverse proxy) ===
BACKEND_URL=http://107.167.94.254:8888
FRONTEND_URL=http://107.167.94.254:3333
NEXT_PUBLIC_API_URL=http://107.167.94.254:8888

# If you have a domain + HTTPS:
# BACKEND_URL=https://api.yourdomain.com
# FRONTEND_URL=https://yourdomain.com
# NEXT_PUBLIC_API_URL=https://api.yourdomain.com

# === Email ===
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@example.com

# === Redis (optional) ===
USE_REDIS_CHANNELS=false
REDIS_URL=redis://redis:6379/1

# === Superadmin ===
SUPERADMIN_ALLOWED_EMAILS=admin@example.com

