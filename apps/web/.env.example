# Dreamy Life Web Frontend — Environment Variables
# Copy this file to .env.local and fill in your values.
# These NEXT_PUBLIC_* variables are exposed to the browser.

# The base URL of the Dreamy Life API backend.
NEXT_PUBLIC_API_URL=http://localhost:4000

# The WebSocket URL for real-time features (feed, notifications).
NEXT_PUBLIC_WS_URL=http://localhost:4000

# Firebase Web Config (Client)
# Get these from: Firebase Console > Project Settings > General > Your apps > Web app
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyA1Q8YfZkslMp6dBLtktLj0PjbDRrIWoD0"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="dreamy-life-98fde.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="dreamy-life-98fde"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="dreamy-life-98fde.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="859662140785"
NEXT_PUBLIC_FIREBASE_APP_ID="1:859662140785:web:f56ca8f5c02c6bcd2c62d0"
# Get VAPID Key from: Firebase Console > Cloud Messaging > Web push certificates > Generate Key Pair
