# Dreamy Life Web Frontend — Environment Variables
# Copy this file to .env and fill in your values.
# These NEXT_PUBLIC_* variables are exposed to the browser.

# The base URL of the Dreamy Life API backend.
# In local development, the backend runs on port 3000 (nest start).
# In Docker Compose, the backend is available at http://backend:4000.
NEXT_PUBLIC_API_URL=http://localhost:3000

# The WebSocket URL for real-time features (feed, notifications).
# Same host as the API in most setups.
NEXT_PUBLIC_WS_URL=http://localhost:3000
